# Local development. On Vercel, use a remote libsql:// database URL and its token.
TURSO_DATABASE_URL=file:playground.db
TURSO_AUTH_TOKEN=
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
SITE_URL=http://localhost:3000
ADMIN_EMAILS=owner@example.com

# Optional: web research and checkout activate when configured and redeployed.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SALES_ENABLED=false

# Optional: enables email verification and password reset emails.
RESEND_API_KEY=
EMAIL_FROM=
